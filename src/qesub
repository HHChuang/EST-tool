#!/bin/bash
#################################################################################
# Program :                                                                     #
#   Create SLURM file(s) to submit electronic structure input file(s).          # 
#   Programs: ORCA 6.1, GAUSSIAN16, Jellyfish, (Q-Chem 5.3, Molpro 2019).       #
#                                                                               #
# History:                                                                      #
# 2015-2020, Grace, SGE versions.                                               #
# 2026/04/10, Grace, Migrated to SLURM for HPC (Hannover).                      #
#################################################################################

# Main program
function main(){
    # 0. global variables setting
        USAGE='Usage: qesub [ -e orca|g16|jellyfish|qchem|molpro ] [ -np procs ] [ -w node|all|node1,node2,... ] [ -N n|auto ] infile'

        debug=''
        threads=1
        mem="8GB"
        partition='mpp.share' # Standard LUIS partition
        time='24:00:00'        # Default time limit
        tag=''
        prcs=1                # DEFAULT PROCESSORS (Allows 'qesub he.inp' to work)
        sweep=''              # -w: node-sweep spec (unset = original split behaviour)
        nNodeOpt=''           # -N: non-interactive batch count ('auto' = 1 per partition node)

    # 1. check arguments
        checkArg $@

    # 2. check and count input files
        genlist $checkArg $input

    # 3. generate SLURM batch scripts: either sweep the full job list across
    #    one or more pinned nodes (-w), or split the job list across N nodes
    #    for throughput (interactively via -N, or automatically via -N auto)
        if [ -n "$sweep" ]; then
            genSweepSLURMfiles list.dat
        else
            if [ -n "$nNodeOpt" ]; then
                resolveAutoNodeCount list.dat
            else
                getNnodefunc list.dat
            fi
            genSLURMfile $getNnode list.dat
        fi

    # 4. submit jobs
        for name in `cat SLURMlist.dat`
        do
            sbatch $name
        done
        rm -f SLURMlist.dat
}

function checkArg()
{
    until [ $# -eq 0 ]
    do 
        case $1 in 
        '-e')
            est=$2
            shift 2
        ;;
        '-np')
            prcs=$2
            shift 2
        ;;
        '-w')
            sweep=$2
            shift 2
        ;;
        '-N')
            nNodeOpt=$2
            shift 2
        ;;
        '-p')
            partition=$2
            shift 2
        ;;
        '-t')
            time=$2
            shift 2
        ;;
        '-m')
            mem=$2
            shift 2
        ;;
        '-h'|'--help') 
            showIllustration
        ;;
        *)
            input=$1
            check_file_extension $input

            case $input in 
            'all') checkArg='2' ;;
            'fail') checkArg='3' ;;
            *.dat) checkArg='4' ;;
            *) checkArg='1' ;;
            esac
            shift
        ;;
        esac
    done  

    if [ "$input" == '' ]; then showIllustration; fi
}

function check_file_extension()
{

    ext="${1##*.}"

    if [ -z "$est" ]; then
        if [ "$ext" == "com" ]; then
            est='g16'
        elif [ "$ext" == "jlf" ]; then
            est='jellyfish'
        else
            est='orca'
        fi
    fi

    if [ "$est" == "g16" ]; then
        inp_ext='com'; out_ext='log'
    elif [ "$est" == "jellyfish" ]; then
        inp_ext='jlf'; out_ext='jlf'
    else
        inp_ext='inp'; out_ext='out'
    fi

}

function jellyfish_input()
{
    # job name 
    local job=$1

    cat << JFEOF
export LD_LIBRARY_PATH=/bigwork/nhcahsch/envs/jellyfish/lib:\$LD_LIBRARY_PATH
export QT_QPA_PLATFORM=offscreen

cd /bigwork/nhcahsch/conda/Jellyfish/build

printf "load \${SLURM_SUBMIT_DIR}/${job}.jlf\ncalculate all -r\nsave \${SLURM_SUBMIT_DIR}/${job}_result\nexit\n" | ./JellyfishCMD/JellyfishCMD
JFEOF
}



function genlist()
{
    case "$1" in 
    '1') echo $2 | cut -d '.' -f 1 > list.dat ;;
    '2') ls *.$inp_ext | sed "s/\.$inp_ext//" > list.dat ;;
    '3') 
        ls *.$out_ext | sed "s/\.$out_ext//" > alljobs.dat 
        rm -f list.dat; touch list.dat 
        for name in `cat alljobs.dat`; do 
            case "$est" in
            # FIXME: what is the keyword of normal termination for jellyfish and molpro? 
                'orca') num=$(grep -c 'ORCA TERMINATED NORMALLY' $name.$out_ext) ;;
                'qchem') num=$(grep -c 'Have a nice day' $name.$out_ext) ;;
                'g16') num=$(grep -c 'Normal termination' $name.$out_ext) ;;
            esac 
            [ "$num" -eq 0 ] && echo $name >> list.dat 
        done 
        rm -f alljobs.dat 
    ;;
    '4') cat $2 | sed "s/\.$inp_ext//" > list.dat ;;
    esac 
}

function getNnodefunc()
{
    njobs=$(wc -l $1 | awk '{print $1}')
    if [ $njobs -eq 1 ]; then getNnode='1'
    else
        echo '--------------------------------------------------------'
        echo "Amount of jobs: $njobs"
        read -p 'How many batch files do you want to split into? ' getNnode
        echo '--------------------------------------------------------'
    fi
}

function resolveAutoNodeCount()
{
    # $1 = list.dat; sets $getNnode non-interactively from -N (skips the
    # getNnodefunc prompt). Batches are NOT pinned to a node (no --nodelist)
    # -- SLURM's own scheduler spreads them across whichever nodes are free.
    njobs=$(wc -l $1 | awk '{print $1}')

    if [ "$nNodeOpt" == 'auto' ]; then
        getNnode=$(sinfo -p $partition -N -h -o "%N" | sort -u | wc -l | awk '{print $1}')
    else
        getNnode=$nNodeOpt
    fi

    [ "$getNnode" -gt "$njobs" ] && getNnode=$njobs
    [ "$getNnode" -lt 1 ] && getNnode=1
}

function genSLURMfile()
{
    nNode=$1
    njobs=$(wc -l $2 | awk '{print $1}')
    jobname=( `cat $2` )
    [ $checkArg -ne 4 ] && rm -f list.dat 

    quotient=$(( $njobs/$nNode ))
    remainder=$(( $njobs%$nNode ))
    sgelist=(WagakkiBand SuzuhanaYuko Machiya NinagawaBeni IbukuroKiyoshi Asa KaminagaDaisuke Wasabi Kurona)
    
    rm -f SLURMlist.dat 
    ini_job=0
    for ((Node_i=1;Node_i<=$nNode;Node_i++))
    do 
        sname=${sgelist[$(( $RANDOM%9 ))]}
        [ -f "$sname.sh" ] && sname="${sname}_$Node_i"
        
        SLURMheader $sname
        
        if [ "$remainder" -eq 0 ]; then joblen=$quotient
        else
            if [ "$Node_i" -le $remainder ]; then joblen=$(( $quotient + 1 ))
            else joblen=$quotient; fi 
        fi 
        
        part_jobname=${jobname[@]:$ini_job:$joblen}
        ini_job=$(( $ini_job + $joblen ))
        
        for job in $part_jobname; do
            appendJobCmd $job $sname.sh
        done
        echo $sname.sh >> SLURMlist.dat
    done
}

function appendJobCmd()
{
    # $1 = job basename, $2 = SLURM script file to append the run command to
    local job=$1
    local scriptfile=$2
    case $est in
        'orca')   echo "\$(which orca) $job.inp > $job.out" >> $scriptfile ;;
        'g16')    echo "g16 $job.com" >> $scriptfile ;;
        'jellyfish') jellyfish_input $job >> $scriptfile ;;
        'qchem')  echo "qchem -nt $prcs $job.inp $job.out" >> $scriptfile ;;
        'molpro') echo "molpro < $job.inp > $job.out" >> $scriptfile ;;
    esac
}

function resolveNodeList()
{
    # sets node.dat: one "<node> <partition>" pair per line, resolved from
    # $sweep. $partition may itself be a comma-separated list of partitions
    # (e.g. 'mpp.share,mpp.single,smp') -- each is queried separately via
    # sinfo so every node keeps the correct partition to submit into.
    rm -f node.dat
    if [ "$sweep" == 'all' ]; then
        for part in $(echo $partition | tr ',' ' '); do
            sinfo -p $part -N -h -o "%N" | sort -u \
                | awk -v p=$part '{print $1, p}' >> node.dat
        done
    else
        # explicit node name(s): partition is ambiguous if -p was also
        # given as a list, so all of them are submitted to the first
        # partition named in -p.
        local firstPart=$(echo $partition | cut -d',' -f1)
        echo $sweep | tr ',' '\n' | awk -v p=$firstPart '{print $1, p}' > node.dat
    fi
}

function genSweepSLURMfiles()
{
    # $1 = list.dat (full job list; every node below runs *all* of it,
    #      unlike genSLURMfile which splits the list across nodes)
    jobname=( `cat $1` )
    [ $checkArg -ne 4 ] && rm -f list.dat

    resolveNodeList

    rm -f SLURMlist.dat
    while read node part
    do
        sname="sweep_${node}"
        mkdir -p $sname
        for job in "${jobname[@]}"; do
            cp $job.$inp_ext $sname/
        done

        SLURMheader $sname $sname $node $part

        for job in "${jobname[@]}"; do
            appendJobCmd $job $sname.sh
        done
        echo $sname.sh >> SLURMlist.dat
    done < node.dat
    rm -f node.dat
}

function SLURMheader()
{
    # $1 = script name (without .sh)
    # $2 = optional: subdir (relative to $SLURM_SUBMIT_DIR) to cd into before running
    # $3 = optional: node name to pin the job to via --nodelist
    # $4 = optional: partition to submit into (defaults to $partition; used
    #      when $partition was given as a comma-separated multi-partition list)
    local subdir=$2
    local node=$3
    local part=${4:-$partition}

cat << EOF > $1.sh
#!/bin/bash -l
#####################################################################
#  Program :                                                        #
#       Submit the EST job(s) through SLURM workload manager.       #
#####################################################################

#SBATCH --job-name=$1
#SBATCH --partition=$part
EOF

[ -n "$node" ] && echo "#SBATCH --nodelist=$node" >> $1.sh

cat << EOF >> $1.sh
#SBATCH --ntasks-per-node=$prcs
#SBATCH --nodes=1
#SBATCH --mem=$mem
#SBATCH --time=$time
#SBATCH --output=$1_%j.log

module purge
EOF

case $est in
    'orca') 
        echo "module load GCC/13.2.0 OpenMPI/4.1.6 ORCA/6.1.0" >> $1.sh 
    ;;
    'g16')  
        echo "module load Gaussian/g16.B01" >> $1.sh 
        ;;
    'jellyfish') 
        echo "export LD_LIBRARY_PATH=/bigwork/nhcahsch/envs/jellyfish/lib:\$LD_LIBRARY_PATH" >> $1.sh 
        echo "export QT_QPA_PLATFORM=offscreen" >> $1.sh 
    ;;
esac

echo '' >> $1.sh 

cat << EOF >> $1.sh
cd \$SLURM_SUBMIT_DIR${subdir:+/$subdir}
echo 'Job starts'
echo "    Host: \$HOSTNAME"
echo '    Date:' \`date\`

EOF
}

function showIllustration()
{
    echo $USAGE
    read -r -s -p $'Press enter to view manual...\n' 
    /usr/bin/perl -x "$0"
    exit 
}

main $@

exit

